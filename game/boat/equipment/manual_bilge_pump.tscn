[node name="EstacionBombeo" type="Area3D" parent="."]
position = Vector3(0, 0.15, 0)
collision_layer = 1
collision_mask = 0
editor_description = "Lo que el rayo del jugador tiene que ENCONTRAR para ofrecer «E bombear». Hace falta un Area3D propia porque el cuerpo sólido de la bomba (PumpPortShape) vive en la raíz del RigidBody del barco, así que un raycast contra él devuelve el FishingBoat entero y el interactor no sabría que estaba mirando la bomba. Capa 1 y máscara 0: se deja ver, no empuja nada."

