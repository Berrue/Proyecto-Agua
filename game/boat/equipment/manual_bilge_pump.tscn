[node name="ManualBilgePump" type="Node3D"]
editor_description = "Módulo autónomo del barco y del Player. Montado en FishingBoat/UpgradeSockets/PumpPort sin offset: su raíz ES el socket y BaseContact compensa los 25 cm hasta cubierta. Lo que frena al jugador es PumpPortShape, en la raíz del barco."
script = ExtResource("1_pump")
stored_coil_path = NodePath("PumpVisual/HoseCoil")

[node name="MountOrigin" type="Marker3D" parent="."]
editor_description = "Origen que más adelante se alineará directamente con UpgradeSockets/PumpPort."

